{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nuxt/renovate-config-nuxt",
    "schedule:weekly",
    "group:allNonMajor"
  ],
  "forkProcessing": "enabled",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchDepTypes": ["peerDependencies", "engines"],
      "enabled": false
    }
  ]
}
